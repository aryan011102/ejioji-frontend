<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where Google sends Safari back to after the consent screen.
	     A Universal Link rather than a custom URL scheme, for the same reason
	     as on Android: a custom scheme can be claimed by any other app on the
	     device, which would hand somebody else the authorization code.

	     The host is the one in the backend's GOOGLE_REDIRECT_URI. Its
	     /.well-known/apple-app-site-association (repo theonebytwo-site) must
	     name <Team ID>.com.theonebytwo.app. Needs a paid Apple developer
	     team: a free Apple ID (Sideloadly) cannot carry this entitlement,
	     so there the redirect opens Safari and no source can be connected. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:theonebytwo.com</string>
	</array>
</dict>
</plist>
